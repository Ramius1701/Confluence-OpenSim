<Project Sdk="Microsoft.NET.Sdk">

  <!-- A child process for compile-limit tests (NestingLimitTests). Not shipped.
       Confluence project file: Confluence paths; hand-maintained, outside OpenSim.sln. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\OpenSim\Region\ScriptEngine\InWorldz.Phlox\InWorldz.Phlox.csproj" />
  </ItemGroup>

  <!-- InWorldz.Phlox takes these from bin\ without copying them; the probe needs them beside it. -->
  <ItemGroup>
    <Reference Include="C5"><HintPath>..\..\bin\C5.dll</HintPath></Reference>
    <Reference Include="log4net"><HintPath>..\..\bin\log4net.dll</HintPath></Reference>
    <Reference Include="OpenMetaverseTypes"><HintPath>..\..\bin\OpenMetaverseTypes.dll</HintPath></Reference>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions"><HintPath>..\..\bin\Microsoft.Extensions.Logging.Abstractions.dll</HintPath></Reference>
  </ItemGroup>

</Project>