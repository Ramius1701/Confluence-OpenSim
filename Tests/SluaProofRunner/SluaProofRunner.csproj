<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offline SLua conformance runner: compiles Luau snippets with the Phlox SLua
       compiler, executes them on the Phlox VM with a recording syscall shim, and
       compares against expected SLua behavior (PASS / DIVERGENCE / GAP buckets).
       Console tool, not part of the grid runtime. Confluence project file: Confluence
       paths and bin\ DLLs; hand-maintained, outside OpenSim.sln.
       Run it with dotnet run, Release configuration, from Tests\SluaProofRunner -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SluaProofRunner</AssemblyName>
    <RootNamespace>Phlox.ScriptEngine</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\OpenSim\Region\ScriptEngine\InWorldz.Phlox\InWorldz.Phlox.csproj" />
    <!-- The same bin\C5.dll identity Phlox is compiled against, copied beside the runner. -->
    <Reference Include="C5"><HintPath>..\..\bin\C5.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="log4net"><HintPath>..\..\bin\log4net.dll</HintPath></Reference>
    <Reference Include="OpenMetaverseTypes"><HintPath>..\..\bin\OpenMetaverseTypes.dll</HintPath></Reference>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions"><HintPath>..\..\bin\Microsoft.Extensions.Logging.Abstractions.dll</HintPath></Reference>
  </ItemGroup>

</Project>