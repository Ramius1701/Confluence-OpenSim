<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the Phlox compiler, VM and engine, from Tranquillity (Tests/InWorldz.Phlox.Tests).
    Confluence project file: Confluence module paths and the shared bin\ DLLs. Hand-maintained, outside OpenSim.sln.
    Run: dotnet test Tests\InWorldz.Phlox.Tests -c Release
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416;CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="dispatch-baseline.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\*.lsl" CopyToOutputDirectory="PreserveNewest" />
    <!-- ZephyrWind's recorded output (OpenSim-Tranquillity #322), read as resources by ZephyrWindSnapshotTests. -->
    <EmbeddedResource Include="Fixtures\Wind\*.bin" />
    <!-- iwStringCodec golden vectors from Halcyon's own code on .NET Framework (Golden/README.md). The
         generator's sources are kept beside them and are not part of this build. -->
    <None Include="Golden\*.jsonl;Golden\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="Golden\**" />
    <!-- OpenSim resolves its natives from bin\lib64 at start; the bare test host needs SQLite's beside it. -->
    <None Include="..\..\bin\lib64\e_sqlite3.dll" Link="e_sqlite3.dll" CopyToOutputDirectory="PreserveNewest" />
    <!-- and OpenJPEG's, which the vector renderer encodes dynamic textures with, under the name libomv imports
         (OpenSim maps that name to the lib64 file at start) -->
    <None Include="..\..\bin\lib64\openjpeg-dotnet-x86_64.dll" Link="openjpeg-dotnet.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Tests of Tranquillity modules Confluence does not have: its SkiaSharp/CoreJ2K VectorRender (Confluence's renders
       differently) and its server-side baking module. -->
  <ItemGroup>
    <Compile Remove="OsslDrawPixelTests.cs" />
    <Compile Remove="SsbNpcAppearanceTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\OpenSim\Region\ScriptEngine\InWorldz.Phlox\InWorldz.Phlox.csproj" />
    <ProjectReference Include="..\..\OpenSim\Region\ScriptEngine\Phlox.ScriptEngine\Phlox.ScriptEngine.csproj" />
    <ProjectReference Include="..\..\OpenSim\Region\ScriptEngine\YEngine\OpenSim.Region.ScriptEngine.YEngine.csproj" />
    <!-- The compile-limit child process (NestingLimitTests). -->
    <ProjectReference Include="..\PhloxCompileProbe\PhloxCompileProbe.csproj" />
    <!-- Scene, client and inventory helpers: upstream's OpenSim/Tests/Common, built by Tests/OpenSim.Tests.Common. -->
    <ProjectReference Include="..\OpenSim.Tests.Common\OpenSim.Tests.Common.csproj" />
  </ItemGroup>

  <!-- The modules take these from bin\ without copying them; the test host needs them beside it. -->
  <ItemGroup>
    <!-- The scene tests reach CoreModules, OptionalModules and the rest of Confluence. -->
    <Reference Include="..\..\bin\OpenSim*.dll" Exclude="..\..\bin\OpenSim.Tests*.dll;..\..\bin\OpenSim.Region.ScriptEngine.YEngine.dll" />
    <!-- [Confluence] Tranquillity #345 tests: the Janus voice service and the module that loads it. -->
    <Reference Include="WebRtcJanusService"><HintPath>..\..\bin\WebRtcJanusService.dll</HintPath></Reference>
    <Reference Include="WebRtcVoice"><HintPath>..\..\bin\WebRtcVoice.dll</HintPath></Reference>
    <Reference Include="WebRtcVoiceServiceModule"><HintPath>..\..\bin\WebRtcVoiceServiceModule.dll</HintPath></Reference>
    <!-- [Confluence] Tranquillity #350 tests: the region module's parcel checks. -->
    <Reference Include="WebRtcVoiceRegionModule"><HintPath>..\..\bin\WebRtcVoiceRegionModule.dll</HintPath></Reference>
    <Reference Include="C5"><HintPath>..\..\bin\C5.dll</HintPath></Reference>
    <!-- [Confluence] GloebitStateRequestTests (the Gloebit money module is not an OpenSim*.dll). -->
    <Reference Include="Gloebit"><HintPath>..\..\bin\Gloebit.dll</HintPath></Reference>
    <Reference Include="XMLRPC"><HintPath>..\..\bin\XMLRPC.dll</HintPath></Reference>
    <Reference Include="log4net"><HintPath>..\..\bin\log4net.dll</HintPath></Reference>
    <Reference Include="Mono.Addins"><HintPath>..\..\bin\Mono.Addins.dll</HintPath></Reference>
    <Reference Include="Nini"><HintPath>..\..\bin\Nini.dll</HintPath></Reference>
    <Reference Include="OpenMetaverse"><HintPath>..\..\bin\OpenMetaverse.dll</HintPath></Reference>
    <Reference Include="OpenMetaverseTypes"><HintPath>..\..\bin\OpenMetaverseTypes.dll</HintPath></Reference>
    <Reference Include="OpenMetaverse.StructuredData"><HintPath>..\..\bin\OpenMetaverse.StructuredData.dll</HintPath></Reference>
    <!-- The vector renderer (osSetDynamicTextureData) draws with System.Drawing, bin\s copy (runprebuild picks the OS one). -->
    <Reference Include="System.Drawing.Common"><HintPath>..\..\bin\System.Drawing.Common.dll</HintPath></Reference>
    <Reference Include="System.Data.SQLite"><HintPath>..\..\bin\System.Data.SQLite.dll</HintPath></Reference>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions"><HintPath>..\..\bin\Microsoft.Extensions.Logging.Abstractions.dll</HintPath></Reference>
  </ItemGroup>

</Project>