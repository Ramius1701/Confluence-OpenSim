[WebRtcVoice]
    Enabled=false
    ; Module to use for spatial WebRtcVoice.
    ; Default here is a plain JSON-RPC client that talks to any grid-wide
    ; voice backend at WebRtcVoiceServerURI below - this is the option to
    ; use with ConfluenceVoice (github.com/Ramius1701/ConfluenceVoice), a
    ; Windows-native voice server built specifically so a grid doesn't need
    ; a Linux host running Janus Gateway. Config in [JanusWebRtcVoice] below
    ; is only needed if you use the Janus alternative instead (see below).
    SpatialVoiceService = WebRtcVoice.dll:WebRtcVoiceServiceConnector
    ; Alternative: a Janus Gateway service just for spatial voice for this
    ; region (needs a Linux host running Janus - see [JanusWebRtcVoice]).
    ; SpatialVoiceService = WebRtcJanusService.dll:WebRtcJanusService
    ; Module to use for non-spatial WebRtcVoice (groups and IMs) - same choice as above.
    NonSpatialVoiceService = WebRtcVoice.dll:WebRtcVoiceServiceConnector
    ; Alternative: local Janus voice service. Config in [JanusWebRtcVoice].
    ; NonSpatialVoiceService = WebRtcJanusService.dll:WebRtcJanusService
    ; URL for the grid-wide voice backend (e.g. a ConfluenceVoice instance).
    ; Used by WebRtcVoiceServiceConnector - required if using that connector above.
    ;WebRtcVoiceServerURI = https://voice.example.org:9443
    ; Debugging: output to log file messages sent and received from the viewer. Very verbose.
    MessageDetails = false
    ; STUN servers to advertise to the viewer via the region's SimulatorFeatures
    ; (VoiceStunServers). Comma-separated host:port list. Firestorm 7.2.4+
    ; requires this to be set or the viewer's WebRTC peer connection is refused.
    ; StunServers = stun2.l.google.com:19302,stun.l.google.com:19302
    ; A refused voice request (voice off on the parcel, a ban, voice off in the estate) is answered again from a cache
    ; for this many seconds, so the viewer's immediate retries (about two a second) do not repeat the checks.
    ; 0 turns the cache off. Default 5.
    ;RefusalCacheSeconds = 5

[JanusWebRtcVoice]
    ; Only needed if SpatialVoiceService/NonSpatialVoiceService above are set
    ; to WebRtcJanusService.dll:WebRtcJanusService instead of the
    ; WebRtcVoice.dll:WebRtcVoiceServiceConnector default - Janus Gateway
    ; itself has no native Windows build, so this path needs a separate
    ; Linux host to run Janus on (it does not need to be co-located with
    ; Robust/the regions).
    ; URI to access the Janus Gateway
    JanusGatewayURI = http://janus.example.org:14223/voice
    ; APIKey to access the Janus Gateway. Must be set to the same value as the Janus Gateway.
    APIToken = APITokenToNeverCheckIn
    ; URI to access the admin port on Janus Gateway
    JanusGatewayAdminURI = http://janus.example.org:14224/admin
    ; APIKey to access the admin port on the Janus Gateway. Must be set to the same value as the Janus Gateway.
    ; Use random secrets of at least 32 characters for APIToken and AdminAPIToken; a shorter one is logged as a
    ; warning at startup.
    AdminAPIToken = AdminAPITokenToNeverCheckIn
    ; For https gateway and admin URLs whose certificate comes from a private CA: that CA's certificate file (PEM or
    ; DER), trusted alongside the system roots for the gateway only; the host name must still match. Default: unset
    ; (the grid's usual HTTP client and certificate settings).
    ;JanusGatewayCACertificateFile =
    ; Debugging: output to log file messages sent and received from Janus. Very verbose.
    MessageDetails = false

    ; Janus plugin the region attaches voice handles to. Default: janus.plugin.audiobridge (Janus's stock
    ; AudioBridge, flat non-spatial mixing). Set janus.plugin.slvoice to use a spatial mixer that implements
    ; that plugin.
    ;PluginName = janus.plugin.audiobridge

    ; How long, in milliseconds, a Janus request that is answered with an ack waits for its result before it fails.
    ; Default 5000.
    ;RequestTimeoutMs = 5000
    ; Remove rooms this region's service created once they have stood empty for EmptyRoomGraceSeconds. On by default
    ; with the stock AudioBridge plugin, which otherwise keeps every emptied room until Janus restarts; never with
    ; another plugin (the slvoice mixer removes its own).
    ;RemoveEmptyRooms = true
    ;EmptyRoomGraceSeconds = 60
