<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Jolt console test commands (`jolt linktest`, `jolt boattest`, `jolt parity` and the rest), from Tranquillity
    develop (Source/OpenSim.Region.PhysicsModules.Jolt.Diagnostics, #339), kept out of the module. The module loads this
    assembly into its own load context only when [Jolt] TestCommands = true and the file is beside it
    (JoltDiagnosticsLoader.cs); it holds no region module of its own.
    Confluence: hand-maintained like the other three Jolt projects; output to the shared bin\.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>OpenSim.Region.PhysicsModules.Jolt.Diagnostics</AssemblyName>
    <RootNamespace>OpenSim.Region.PhysicsModules.Jolt.Diagnostics</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <PreserveCompilationContext>false</PreserveCompilationContext>
    <Deterministic>true</Deterministic>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>False</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>False</AppendRuntimeIdentifierToOutputPath>
    <UseCommonOutputDirectory>True</UseCommonOutputDirectory>
    <OutputPath>..\..\..\..\bin\</OutputPath>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <NoWarn>CA1416,SYSLIB0011,SYSLIB0014,SYSLIB0039</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="log4net"><HintPath>..\..\..\..\bin\log4net.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Mono.Addins"><HintPath>..\..\..\..\bin\Mono.Addins.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Nini"><HintPath>..\..\..\..\bin\Nini.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="OpenMetaverse"><HintPath>..\..\..\..\bin\OpenMetaverse.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="OpenMetaverseTypes"><HintPath>..\..\..\..\bin\OpenMetaverseTypes.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions"><HintPath>..\..\..\..\bin\Microsoft.Extensions.Logging.Abstractions.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Framework\OpenSim.Framework.csproj" />
    <ProjectReference Include="..\..\Framework\OpenSim.Region.Framework.csproj" />
    <ProjectReference Include="..\SharedBase\OpenSim.Region.PhysicsModules.SharedBase.csproj" />
    <ProjectReference Include="..\Meshing\OpenSim.Region.PhysicsModule.Meshing.csproj" />
    <ProjectReference Include="..\Jolt.Backend\OpenSim.Region.PhysicsModules.Jolt.Backend.csproj" />
    <ProjectReference Include="..\Jolt.Vehicles\OpenSim.Region.PhysicsModules.Jolt.Vehicles.csproj" />
    <ProjectReference Include="..\Jolt\OpenSim.Region.PhysicsModules.Jolt.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="JoltPhysicsSharp" Version="2.23.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OpenSim.Region.PhysicsModules.Jolt.Diagnostics.Tests" />
  </ItemGroup>
</Project>
