<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The vehicle controller, from Legion's Tranquillity lane/jolt (Source/OpenSim.Region.PhysicsModules.Jolt.Vehicles).
    It references neither OpenSim nor a physics engine, only the OpenMetaverse math types; the Jolt module implements
    IVehicleBody (JoltVehicleBody) on top of the backend.
    Hand-maintained and outside OpenSim.sln: do not run runprebuild against this tree.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>OpenSim.Region.PhysicsModules.Jolt.Vehicles</AssemblyName>
    <RootNamespace>OpenSim.Region.PhysicsModules.Jolt.Vehicles</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Company>http://opensimulator.org</Company>
    <Product>OpenSim</Product>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="OpenMetaverseTypes">
      <HintPath>..\..\..\..\bin\OpenMetaverseTypes.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
