<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Phlox script engine region module (a second engine beside YEngine), from Tranquillity
    (Source/Phlox.ScriptEngine). See doc/PhloxSetup.md and CONFLUENCE.md here. Confluence project file: hand-maintained
    and outside OpenSim.sln (like Jolt); builds into the shared bin\ and references Confluence's own DLLs there.
    System.Data.SQLite is Confluence's own copy in bin\ (one version in the process), not Tranquillity's 2.0.4 package.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>Phlox.ScriptEngine</AssemblyName>
    <RootNamespace>Phlox.ScriptEngine</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <PreserveCompilationContext>false</PreserveCompilationContext>
    <EnableDefaultItems>false</EnableDefaultItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\..\..\bin\</OutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>CA1416,SYSLIB0011,SYSLIB0014,SYSLIB0039</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="protobuf-net" Version="3.2.56" />
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InWorldz.Phlox\InWorldz.Phlox.csproj"><Private>False</Private></ProjectReference>
    <ProjectReference Include="..\..\..\Framework\OpenSim.Framework.csproj"><Private>False</Private></ProjectReference>
    <ProjectReference Include="..\..\Framework\OpenSim.Region.Framework.csproj"><Private>False</Private></ProjectReference>
    <ProjectReference Include="..\Shared\OpenSim.Region.ScriptEngine.Shared.csproj"><Private>False</Private></ProjectReference>
    <ProjectReference Include="..\Shared\Api\Implementation\OpenSim.Region.ScriptEngine.Shared.Api.csproj"><Private>False</Private></ProjectReference>
    <ProjectReference Include="..\..\OptionalModules\OpenSim.Region.OptionalModules.csproj"><Private>False</Private></ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Data.SQLite"><HintPath>..\..\..\..\bin\System.Data.SQLite.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="C5"><HintPath>..\..\..\..\bin\C5.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="log4net"><HintPath>..\..\..\..\bin\log4net.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Mono.Addins"><HintPath>..\..\..\..\bin\Mono.Addins.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Nini"><HintPath>..\..\..\..\bin\Nini.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="OpenMetaverse"><HintPath>..\..\..\..\bin\OpenMetaverse.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="OpenMetaverseTypes"><HintPath>..\..\..\..\bin\OpenMetaverseTypes.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="OpenMetaverse.StructuredData"><HintPath>..\..\..\..\bin\OpenMetaverse.StructuredData.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="XMLRPC"><HintPath>..\..\..\..\bin\XMLRPC.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions"><HintPath>..\..\..\..\bin\Microsoft.Extensions.Logging.Abstractions.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Tranquillity's compile list, unchanged. -->
    <Compile Include="LSLSystemAPI.cs" />
    <Compile Include="LSLSystemAPI.Confluence.cs" />
    <Compile Include="PhloxExperienceAdapter.cs" />
    <Compile Include="PhloxEngine.cs" />
    <Compile Include="PhloxEngineHeader.cs" />
    <Compile Include="OsslGate.cs" />
    <Compile Include="SluaBackHalfProof.cs" />
    <Compile Include="PhloxExecutionScheduler.cs" />
    <Compile Include="PhloxLoadRequest.cs" />
    <Compile Include="PhloxMasterScheduler.cs" />
    <Compile Include="PhloxScriptLoader.cs" />
    <Compile Include="WorkStatus.cs" />
    <Compile Include="SlConst.cs" />
    <Compile Include="ScriptRegex.cs" />
    <Compile Include="PhloxListenManager.cs" />
    <Compile Include="PhloxNotecardCache.cs" />
    <Compile Include="AsyncCommand\AsyncCommandManager.cs" />
    <Compile Include="AsyncCommand\Plugins\SensorRepeat.cs" />
    <Compile Include="AsyncCommand\Plugins\HttpRequest.cs" />
    <Compile Include="AsyncCommand\Plugins\XmlRequest.cs" />
    <Compile Include="StateManager.cs" />
    <Compile Include="Codecs\HalcyonStringCodec.cs" />
    <Compile Include="Codecs\FrameworkGzip.cs" />
    <Compile Include="Codecs\ZlibDeflate.cs" />
    <Compile Include="Codecs\FrameworkText.cs" />
    <!-- Confluence only: Mono.Addins registration. -->
    <Compile Include="ConfluenceRegistration.cs" />
  </ItemGroup>

</Project>
