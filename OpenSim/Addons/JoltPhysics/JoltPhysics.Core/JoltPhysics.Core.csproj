<Project Sdk="Microsoft.NET.Sdk">

  <!--
    JoltPhysics.Core - the engine-agnostic physics backend seam (IJoltPhysicsBackend).

    MILESTONE 1: self-contained. This library links NEITHER OpenSim NOR BulletSim and is
    NOT a selectable [Startup] physics module yet. It builds to its OWN local bin\, kept
    deliberately out of the shared ..\..\..\..\bin\ so it cannot touch the running grid's
    physics selection. Output target changes only when it becomes `physics = Jolt` (M6).

    Csproj is hand-maintained: EnableDefaultItems is OFF, every .cs needs an explicit
    <Compile Include>. Do NOT run runprebuild against this tree.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>JoltPhysics.Core</AssemblyName>
    <RootNamespace>JoltPhysics.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultItems>false</EnableDefaultItems>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><!-- 2.19.x HeightFieldShapeSettings takes float* -->
    <NoWarn>$(NoWarn);CS0168</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Local bin only. Default SDK output (bin\<Config>\net8.0\) is already project-local;
         we intentionally do NOT redirect to the shared OpenSim bin this milestone. -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="IJoltPhysicsBackend.cs" />
    <Compile Include="JoltPhysicsBackend.cs" />
  </ItemGroup>

  <!-- Jolt binding. 2.23.0 pulls native JoltPhysics.Native 1.1.0, built from the official Jolt Physics
       v5.6.0 release (jrouwe/JoltPhysics). Native joltc.dll ships in the JoltPhysics.Native dependency
       under runtimes/<rid>/native/; single precision (joltc.dll) is the default load, double
       (joltc_double.dll) is opt-in - decision #2 is closed on single.
       History: 2.18.6 -> 2.19.1 (native 1.0.4, Jolt v5.4.0) for the M7 frame-0 welded-compound-vs-
       heightfield Update spin; held at 2.19.1, the last net8.0 release, until the 2026-10-11 move to
       net10; 2.19.1 -> 2.23.0 on 2026-10-12. Keep in lockstep with the region module's csproj. -->
  <ItemGroup>
    <PackageReference Include="JoltPhysicsSharp" Version="2.23.0" />
  </ItemGroup>

</Project>
