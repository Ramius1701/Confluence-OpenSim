;; OpenSimWeather 0.3.3 common configuration example
;;
;; Copy this file to config/OpenSimWeather.ini (dropping the .example
;; extension) - OpenSimDefaults.ini's "Include-modules" glob picks up
;; addon-modules/*/config/*.ini automatically. That glob expansion happens
;; AFTER OpenSim.ini has already been merged. Nini's Merge only overwrites a
;; key if THIS file also defines that same key, so any key set below always
;; wins over the same key in OpenSim.ini/Regions.ini, but a key left unset
;; here falls through to whatever OpenSim.ini/Regions.ini set instead. To
;; guarantee a setting is authoritative, define it here explicitly.
;;
;; This example contains the settings most region operators normally need.
;; See OpenSimWeather.reference.ini.example and the focused examples for every
;; advanced tuning option. Asset settings use OpenSim asset UUIDs.

[Weather]
    ;; Master switch. Keep false until particle texture UUIDs are configured.
    Enabled = false

    ;; Private non-zero command channel. Channel 0 is rejected.
    CommandChannel = 89
    EstateManagerOnly = true

    ;; Rain and snow fall around the avatars present, from emitters a short
    ;; drop above each one, and reach the ground. See the RAIN AND SNOW notes
    ;; in OpenSimWeather.reference.ini.example for the keys; the defaults
    ;; suit most regions.
    ;PrecipitationHeightMeters = 22
    ;PrecipitationRadiusMeters = 32
    ;ParticleBudget = 2500
    ;PrecipitationDensity = 1.0

    ;; Height above the terrain for the lightning flashes.
    EmitterHeight = 80.0

    ;; Upload suitable alpha textures and paste their asset UUIDs here.
    RainTexture =
    StormTexture =
    SnowTexture =
    LightningTexture =
    ;; BlizzardTexture defaults to SnowTexture if left unset.
    ;; BlizzardTexture =

    ;; Particle systems cannot collide with roofs. These options suppress
    ;; covered cells and permit explicit no-weather volumes in complex builds.
    AvoidCoveredAreas = true
    UseExclusionVolumes = true
    ExclusionObjectName = Weather Exclusion
    CleanupGeneratedObjectsOnStartup = true

    ;; Region environment and wind changes are opt-in.
    AdjustEnvironment = false
    RestoreCloudsOnClear = true

    AdjustWind = false
    RestoreWindOnClear = true

    ;; Storm effects. Thunder requires a valid uploaded sound UUID.
    LightningEnabled = true
    ThunderEnabled = false
    ThunderSound =

    ;; Automatic cycling and entry messages are opt-in.
    AutoCycleEnabled = false
    AutoCycleHours = 1.0
    AutoCycleChoices = storm,rain,snow,blizzard,sunny,clear
    SendWeatherIMOnEntry = false
    ;; Placeholders: {RegionName} {Weather} {Temperature} {EmitterCount}
    ;;               {AutoCycle} {NextForecast}
    WeatherIMMessage = Weather forecast for {RegionName}: current conditions are {Weather}, {Temperature}C. Next forecast: {NextForecast}. Stay tuned for further regional updates.

    ;; Base temperature (C) per weather kind, applied whenever weather
    ;; changes (manually or via auto cycle) and re-rolled with +/- variance.
    ;; Repeated "weather status" checks between weather changes always
    ;; report the same value.
    ClearTemperatureC = 14
    SunnyTemperatureC = 22
    RainTemperatureC = 12
    StormTemperatureC = 9
    SnowTemperatureC = -2
    BlizzardTemperatureC = -12
    TemperatureVarianceC = 3

    ;; Broadcasts a "weather report" style announcement to everyone in the
    ;; region (region-wide chat) whenever the weather actually changes, in
    ;; addition to the private reply "weather status" always gives to
    ;; whoever asks.
    AnnounceWeatherChangesInChat = true

    ;; Experimental temporary terrain overlays are opt-in.
