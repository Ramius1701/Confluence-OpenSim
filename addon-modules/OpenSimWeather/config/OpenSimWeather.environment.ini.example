;; OpenSimWeather 0.5.0 environment/wind example
;;
;; The weather sky is each avatar's own override and is never stored on the
;; region. Each weather changes the region's own skies (clouds up, colours
;; greyer and darker, more haze, fewer stars), so a midnight sky stays dark, and
;; a change of weather fades in over SkyFadeSeconds.

[Weather]
    Enabled = false
    CommandChannel = 89
    EstateManagerOnly = true


    RainTexture =
    StormTexture =
    SnowTexture =
    LightningTexture =

    AvoidCoveredAreas = true
    CoverProbeGrid = 3
    MinimumOpenSkyFraction = 0.67
    UseExclusionVolumes = true
    ExclusionObjectName = Weather Exclusion

    AdjustEnvironment = true
    RestoreCloudsOnClear = true

    AdjustWind = true
    RestoreWindOnClear = true
    WindDirectionDegrees = 70.0
    WindDirectionVarianceDegrees = 18.0
    RainWindStrength = 0.45
    StormWindStrength = 1.35
    SnowWindStrength = 0.22

    LightningEnabled = true
    ThunderEnabled = false
    AutoCycleEnabled = false

;; The weather skies are changes to the region's own skies; see the
;; WEATHER SKIES notes in OpenSimWeather.reference.ini.example for the
;; [Weather.Sky.<Weather>] keys. The built-in skies need no section.
