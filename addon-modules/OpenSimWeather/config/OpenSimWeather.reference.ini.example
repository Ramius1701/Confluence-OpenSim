;; OpenSimWeather 0.3.4 complete configuration reference
;;
;; Put these sections in OpenSim.ini, or in a file explicitly included by
;; OpenSim.ini. Do not place them in Regions.ini.
;;
;; All asset settings take OpenSim asset UUIDs, not filenames or inventory names.
;; This reference is deliberately disabled and conservative.

[Weather]

    ;; Master switch. A missing section or Enabled=false means fully disabled.
    Enabled = false

    ;; Private non-zero chat channel used for in-world commands.
    ;; CommandChannel=0 is rejected and replaced with 89.
    CommandChannel = 89

    ;; true: only estate managers/owners may use weather commands.
    EstateManagerOnly = true

    ;; ------------------------------------------------------------------------
    ;; WEATHER COVERAGE AND VAR-REGIONS
    ;; ------------------------------------------------------------------------

    ;; Three coverage modes:
    ;;   Region     - a grid of emitters spread across the whole region.
    ;;                Best for small/legacy regions or showcase builds where
    ;;                weather should be visible from anywhere.
    ;;   ActiveArea - only maintains emitters around connected avatars. Cheap
    ;;                regardless of region size; nothing renders where nobody
    ;;                is standing.
    ;;   Wandering  - a fixed-size pool of emitters (WanderingBatchSize) that
    ;;                periodically relocate to new random spots, so weather
    ;;                looks like drifting, patchy cells rather than a uniform
    ;;                static grid. Pool size is independent of region size, so
    ;;                startup stays fast and coverage stays bounded even on
    ;;                very large var regions - coverage is probabilistic, not
    ;;                guaranteed everywhere at once. Recommended over Region
    ;;                for large var regions.
    CoverageMode = Region

    ;; Region mode only. EmitterGrid=0 scales the emitter COUNT to
    ;; RegionSizeX/RegionSizeY using EmitterSpacingMeters below, which keeps
    ;; each emitter's particle burst radius sane on variable-sized regions.
    ;; A fixed non-zero EmitterGrid instead scales spacing (and burst radius)
    ;; up with region size, and radius silently exceeds the viewer's ~50m
    ;; PSYS_SRC_BURST_RADIUS limit on var regions of 1024m or larger (the
    ;; module clamps to 50m as a safety net, but coverage gets sparse well
    ;; before that) - only use a fixed grid count on legacy 256m regions.
    EmitterGrid = 0

    ;; Used by Region mode when EmitterGrid=0, and always by ActiveArea and
    ;; Wandering modes. The module calculates independent X and Y cell counts
    ;; (or pool positions) from the region size and this spacing.
    EmitterSpacingMeters = 24.0

    ;; Safety ceiling on emitter object count for Region spacing mode and
    ;; ActiveArea mode. A fixed EmitterGrid is also reduced when its
    ;; requested object count exceeds this.
    MaxEmitters = 384

    ;; ActiveArea radius around each root agent and refresh interval.
    ActiveAreaRadiusMeters = 96.0
    ActiveAreaRefreshSeconds = 3

    ;; Wandering mode only. Pool size stays constant regardless of region
    ;; size; WanderingChurnFraction of the pool relocates every
    ;; WanderingRefreshSeconds.
    WanderingBatchSize = 40
    WanderingRefreshSeconds = 20
    WanderingChurnFraction = 0.25

    ;; Particle burst radius as a fraction of the calculated cell spacing.
    ;; Hard-clamped to 50m (the viewer's practical PSYS_SRC_BURST_RADIUS
    ;; limit) regardless of this scale or the computed spacing.
    EmitterRadiusScale = 0.62

    ;; Height above local terrain used for the invisible emitter object.
    EmitterHeight = 18.0

    ;; Global precipitation multiplier. Raise cautiously.
    Intensity = 1.0

    ;; ------------------------------------------------------------------------
    ;; PARTICLE AND LIGHTNING ASSETS
    ;; ------------------------------------------------------------------------

    ;; Configure uploaded alpha textures here. Blank values use OpenSim's blank
    ;; texture and can produce visible square/rectangular particle billboards.
    RainTexture =
    StormTexture =
    SnowTexture =
    LightningTexture =

    ;; ------------------------------------------------------------------------
    ;; BUILDING / COVER SUPPRESSION
    ;; ------------------------------------------------------------------------

    ;; OpenSim particles do not collide with roofs. These settings suppress
    ;; whole weather cells whose sampled area is sufficiently covered.
    AvoidCoveredAreas = true
    CoverProbeHeight = 256.0

    ;; Odd sample grid from 1-7. 3 means nine probes per weather cell.
    CoverProbeGrid = 3

    ;; Required fraction of sampled points with open sky before a cell exists.
    MinimumOpenSkyFraction = 0.67

    ;; Do not maintain an ActiveArea weather bubble around an avatar detected
    ;; under cover.
    SuppressAroundCoveredAvatars = true

    ;; false ignores phantom prims during physics cover rays. This also prevents
    ;; the module's own phantom emitters from being mistaken for roofs.
    ;; Explicit exclusion volumes below still work when they are phantom.
    CoverIncludesPhantomPrims = false
    CoverMaxHits = 32

    ;; Optional named prim/linkset volumes for interiors, caves, hangars, and
    ;; complex roofs. Any object's name equal to or beginning with
    ;; "Weather Exclusion" is treated as a no-weather X/Y volume.
    UseExclusionVolumes = true
    ExclusionObjectName = Weather Exclusion
    ExclusionRefreshSeconds = 30

    ;; Remove non-persistent weather objects left by an earlier module instance
    ;; when this region module loads.
    CleanupGeneratedObjectsOnStartup = true

    ;; ------------------------------------------------------------------------
    ;; REGION ENVIRONMENT / EEP-LIGHTSHARE
    ;; ------------------------------------------------------------------------

    ;; Canonical switch. AdjustClouds remains accepted as a legacy alias.
    ;; The weather sky is each avatar's own override; the region's stored
    ;; environment is never changed, so nothing is left behind after a crash.
    AdjustEnvironment = false
    RestoreCloudsOnClear = true

    ;; ------------------------------------------------------------------------
    ;; WIND
    ;; ------------------------------------------------------------------------

    ;; Only SimpleRandomWind and ConfigurableWind are modified.
    AdjustWind = false
    RestoreWindOnClear = true
    WindDirectionDegrees = 70.0
    WindDirectionVarianceDegrees = 18.0
    RainWindStrength = 0.45
    StormWindStrength = 1.35
    SnowWindStrength = 0.22

    ;; ------------------------------------------------------------------------
    ;; LIGHTNING AND THUNDER
    ;; ------------------------------------------------------------------------

    LightningEnabled = true
    LightningMinDelayMS = 7000
    LightningMaxDelayMS = 18000

    ;; Thunder requires a valid uploaded sound asset UUID.
    ThunderEnabled = false
    ThunderVolume = 1.0
    ThunderSound =

    ;; ------------------------------------------------------------------------
    ;; AUTOMATIC WEATHER
    ;; ------------------------------------------------------------------------

    AutoCycleEnabled = false
    AutoCycleHours = 1.0
    AutoCycleStartupDelaySeconds = 30
    AutoCycleChangeOnStartup = false
    AutoCycleChoices = storm,rain,snow,sunny,clear

    ;; "Random" (default) picks the next auto-cycle weather with a plain
    ;; memoryless dice roll, same as always. "Pressure" instead simulates a
    ;; barometric pressure that drifts toward an occasionally-re-rolled
    ;; target each cycle, and picks weather by which severity band (fair /
    ;; moderate / severe) it currently sits in - so a storm is more likely
    ;; to ease into rain or clear over the next few cycles than to jump
    ;; straight back to another storm. Still only ever picks from
    ;; AutoCycleChoices above.
    AutoCyclePacing = Random

    ;; Warning must be shorter than the cycle interval.
    ;; Placeholders: {RegionName} {NextWeather} {TimeUntilNextForecast}
    ;;               {NextForecast}
    AutoCycleForecastWarningMinutes = 15
    AutoCycleForecastWarningMessage = Weather forecast update: next conditions for {RegionName} are expected to shift to {NextWeather} in {TimeUntilNextForecast}.

    ;; ------------------------------------------------------------------------
    ;; ENTRY MESSAGE
    ;; ------------------------------------------------------------------------

    SendWeatherIMOnEntry = false
    WeatherIMDelaySeconds = 8

    ;; Placeholders: {RegionName} {Weather} {EmitterCount} {AutoCycle}
    ;;               {NextForecast}
    WeatherIMMessage = Weather forecast for {RegionName}: current conditions are {Weather}. Next forecast: {NextForecast}.

    ;; Sends a human-readable weather report directly to every avatar in the
    ;; region whenever weather changes.
    AnnounceWeatherChangesInChat = true

    ;; ------------------------------------------------------------------------
    ;; SCRIPT BROADCAST (for independent in-world FX objects)
    ;; ------------------------------------------------------------------------

    ;; Sends a plain "WEATHER|<Kind>" region-wide chat message (Kind is one
    ;; of Clear/Sunny/Rain/Storm/Snow/Blizzard) on every weather change, for
    ;; any scripted prim - a fireplace, seasonal clothing, an umbrella - that
    ;; isn't part of this module to react to. A prim just needs to
    ;; llListen() on WeatherBroadcastChannel and parse the message itself;
    ;; no other integration is required. Independent of
    ;; AnnounceWeatherChangesInChat above, which sends a human-readable
    ;; report to avatars, not scripts.
    BroadcastWeatherToScripts = true
    WeatherBroadcastChannel = -910088

    ;; Base regional temperature in Celsius (reports and the weather broadcast).
    TemperatureC = 10.0

;; ---------------------------------------------------------------------------
;; WEATHER SKIES
;; ---------------------------------------------------------------------------
;; A weather changes each sky of the region's day cycle relative to that sky's
;; own values (it does not put its own colours into every sky): clouds are raised
;; to the weather's cover and never lowered, the horizon, blue density and cloud
;; colours are made greyer and darker by a factor, haze and density are added,
;; and the stars and moon are dimmed. A midnight sky stays dark. Clear and sunny
;; show the region's own sky. The built-in numbers suit most regions; a
;; [Weather.Sky.<Rain|Storm|Snow|Blizzard>] section changes any of them:
;;
;;   CloudCover      0..1  the cover the weather brings (a cloudier sky keeps its own)
;;   CloudScale            the cloud scale it brings
;;   CloudDarken           multiplier on the cloud colour (storms 0.35, snow 0.95)
;;   SkyDarken             multiplier on the horizon and blue density colours
;;   Desaturate      0..1  how far those colours go to grey
;;   AmbientScale, SunScale, MoonScale   multipliers on the light
;;   HazeDensityAdd, HazeHorizonAdd      added to the sky's haze
;;   DensityScale, DistanceScale         multipliers on the atmosphere (visibility)
;;   StarDim         0..1  how much of the stars the clouds hide
;;
;; [Weather.Environment.*] sections from earlier versions are no longer read.
;;
;; A change of weather fades the sky over SkyFadeSeconds (in [Weather], default
;; 120; 0 changes it at once), one step every SkyFadeStepSeconds (default 10).

;[Weather.Sky.Storm]
;    CloudDarken = 0.35
;    SkyDarken = 0.5
;    HazeDensityAdd = 0.5
